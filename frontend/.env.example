# ─────────────────────────────────────────────────────────────────────────────
# PharmaDrop Frontend — Environment Variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Django Backend URL (local dev — proxied by Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ── Pusher Channels (FREE Sandbox tier) ──────────────────────────────────────
# Sign up at https://pusher.com → Create App → Channels
# Copy your credentials from the "App Keys" tab
# Free tier: 200 concurrent connections, 200k messages/day — no credit card needed
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1

# ── Optional Future Keys ─────────────────────────────────────────────────────
# VITE_MAPS_API_KEY=
